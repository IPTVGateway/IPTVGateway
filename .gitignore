# ── Delphi / RAD Studio ───────────────────────────────────────────────
__history/
__recovery/
*.local
*.identcache
*.projdata
*.tvsconfig
*.dsk
*.stat
*.~*
modules/

# Build output
.Output/
_run/
_smoke/
__out/
backend/**/Win32/
backend/**/Win64/
backend/**/Linux64/
backend/**/Android*/
backend/**/iOS*/
backend/**/OSX*/
*.dcu
*.exe
*.dll
*.bpl
*.dcp
*.so
*.map
*.drc
*.res

# Boss (Delphi dependency manager) — vendored deps are restored via `boss install`
backend/modules/
backend/boss-lock.json

# ── Node / frontend ───────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.log
.env.local
.env.*.local

# ── Editors / OS ──────────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
.DS_Store

# ── Runtime data ──────────────────────────────────────────────────────
*.sqlite
*.sqlite-shm
*.sqlite-wal
data/

# ── Secrets ───────────────────────────────────────────────────────────
# real IPTV subscription details for the live integration tests
backend/tests/test.credentials.json
# runtime config (next to the exe); the committed templates are
# backend/config.sample.json and deploy/docker/config.json
/config.json
/backend/config.json


# ── Local-only files (never publish) ──────────────────────────────────
github.txt
secrets.txt
IPTV Abo's.txt
*.secret
*.secrets.json

# ── Generated deploy artefacts (built by deploy/docker/build.ps1) ─────
deploy/docker/IPTVPlayService
deploy/docker/webui/
backend/src/**/_run/

# ── Vendored third-party: keep only what the build uses ───────────────
# FastMM5 is not linked by any project
backend/3thParty/FastMM5-*/
# MARS-Curiosity: only Source/ + ThirdParty/{mORMot,delphi-jose-jwt} are vendored
# (tools/update-mars.ps1 copies just those; see backend/3thParty/DEPENDENCIES.md)

# ── Exceptions: needed to build from a fresh clone ────────────────────
!deploy/linux-sysroot/**
!backend/src/host_*/*.res
!backend/tests/IPTVPlayTests.res
frontend/*.tsbuildinfo

# local publish target for deploy/docker/build.ps1
*.local.txt
